pipeline {
    agent any

    environment {
        APP_ENV = "local"
        APP_DEBUG = "true"
        APP_KEY = ""
        DB_CONNECTION = "mysql"
        DB_HOST = "127.0.0.1"
        DB_PORT = "3306"
        DB_DATABASE = "bookshare"
        DB_USERNAME = "laravel"
        DB_PASSWORD = "secret123"

        // Jenkins credentials id should reference a username/password credential for the registry
        registryCredentials = "c9e556bb-7b93-4c3f-9058-2c2ab7cd8b68"
        registry = "192.168.33.10:8083"

        PHP_PATH = "/usr/bin/php"
        COMPOSER_PATH = "/usr/local/bin/composer"
        NODE_PATH = "/usr/bin/npm"
        PYTHON_PATH = "/usr/bin/python3"
    }

    stages {
        stage('Checkout') {
            steps {
                echo '📦 Checkout du code depuis GitHub...'
                git branch: 'main', url: 'https://github.com/Abdessalem-Chaouch/Bookshare.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                echo '📦 Installation des dépendances Laravel & NPM...'
                sh '${COMPOSER_PATH} install --no-interaction --prefer-dist --no-progress'
                sh '${NODE_PATH} install'
            }
        }

        stage('Setup Environment') {
            steps {
                echo '⚙️ Configuration du .env et génération de la clé...'
                sh '''
                    if [ ! -f .env ]; then
                        cp .env.example .env
                    fi
                    ${PHP_PATH} artisan key:generate
                '''
            }
        }

        stage('Ensure MySQL is running') {
            steps {
                echo '🛡️ Vérification du service MySQL...'
                sh '''
                    sudo service mysql start || true
                    until mysqladmin ping -h${DB_HOST} -P${DB_PORT} --silent; do
                        echo "⏳ Attente du démarrage de MySQL..."
                        sleep 2
                    done
                    echo "✅ MySQL est opérationnel"
                '''
            }
        }

        stage('Create Database if not exists') {
            steps {
                echo '🗄️ Création de la base de données si nécessaire...'
                sh '''
                    mysql -h${DB_HOST} -P${DB_PORT} -u${DB_USERNAME} -p${DB_PASSWORD} \
                      -e "CREATE DATABASE IF NOT EXISTS ${DB_DATABASE} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
                '''
            }
        }

        stage('Run Migrations & Storage') {
            steps {
                echo '🗄️ Migrations & storage link...'
                sh '''
                    ${PHP_PATH} artisan migrate --force
                    ${PHP_PATH} artisan storage:link || true
                '''
            }
        }

        stage('Build Vite') {
            steps {
                echo '⚙️ Build Vite...'
                sh '${NODE_PATH} run build'
            }
        }

        stage('Run Laravel Schedule & Python AI Scripts') {
            steps {
                echo '🤖 Scheduler & AI scripts...'
                sh '''
                    # Installer les dépendances Python
                    if [ -f Ai/requirements.txt ]; then
                        echo "📦 Installation des dépendances Python..."
                        ${PYTHON_PATH} -m pip install --upgrade pip
                        ${PYTHON_PATH} -m pip install -r Ai/requirements.txt
                        ${PYTHON_PATH} -m pip install --upgrade accelerate
                    else
                        echo "⚠️ Aucun requirements.txt dans Ai/"
                    fi

                    # Lancer scheduler Laravel en arrière-plan
                    nohup ${PHP_PATH} artisan schedule:work >/dev/null 2>&1 &

                    # Dataset & entraînements
                    if [ ! -d Ai/load_booksum ]; then
                        echo "📦 Dataset manquant. Génération..."
                        ${PYTHON_PATH} Ai/load_booksum.py
                    fi

                    ${PYTHON_PATH} Ai/train_booksum.py
                    ${PYTHON_PATH} Ai/train_books_model.py

                    # Lancer Flask en arrière-plan
                    nohup ${PYTHON_PATH} Ai/app.py >/dev/null 2>&1 &

                    # ai_model scripts (optionnel)
                    if [ -d ai_model ]; then
                        cd ai_model
                        ${PYTHON_PATH} train_model.py || true
                        ${PYTHON_PATH} predict.py 5 25 || true
                    fi
                '''
            }
        }

        stage('SonarQube Analysis') {
            environment { SONAR_TOKEN = credentials('sonar-token-id') }
            steps {
                echo '🔍 SonarQube analysis (placeholder)'
                // Exemple d'appel (décommenter si sonar-scanner est disponible)
                // sh "sonar-scanner -Dsonar.login=${SONAR_TOKEN}"
            }
        }

        stage('Build Docker Images') {
            steps {
                echo '🐳 Build Docker image for app...'
                
            }
        }

        stage('Push Docker Images to Nexus') {
            steps {
                script {
                    echo '📤 Push images to Nexus (using credentials id)...'
                   
                }
            }
        }

        stage('Deploy with Docker Compose') {
            steps {
                echo '🚀 Deploy with docker-compose (if docker-compose.yml present)...'
               
            }
        }

        stage('Prometheus / Grafana (Placeholder)') {
            steps {
                echo '📊 Placeholder: Prometheus & Grafana via docker-compose (si configurés)'
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline exécutée avec succès ! Application Laravel + AI opérationnelle 🎉'
        }
        failure {
            echo '❌ Échec de la pipeline ! Vérifie les logs Jenkins pour plus de détails.'
        }
    }
}
